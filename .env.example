# AFK Environment Configuration
# Copy to .env and adjust for your environment.

# Required in production
# AFK_SECRET_KEY=generate-with-python-secrets-token_urlsafe-48

AFK_ENV=development
AFK_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Demo data (admin@afk.agency / password123) — off by default for real founders
AFK_SEED_DEMO=false

# One-click demo sessions (POST /api/auth/demo) — on in dev, set true in production
# AFK_DEMO_MODE=true

# Optional: Analyst LLM (explains diagnosis only; never generates it)
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Database (default: sqlite:///database.db in project root)
# DATABASE_URL=sqlite:///database.db